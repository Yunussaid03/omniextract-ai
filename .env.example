# Application Configuration
APP_NAME=OmniExtract AI
APP_ENV=development

# Database Configuration (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/omniextract_db

# Document Storage Settings
STORAGE_DIR=storage/documents
MAX_UPLOAD_SIZE_BYTES=10485760

# Multimodal LLM Integration (Placeholders for future use)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
